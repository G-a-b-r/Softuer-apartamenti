# Neon connection string. Остави празно за локална SQLite база (backend/apartments.db).
# Пример: postgresql+psycopg2://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Разрешени CORS произходи за API (запетая разделени). По подразбиране: *
# При деплой ограничи до домейна на фронтенда, напр.:
# CORS_ALLOWED_ORIGINS=https://softuer-apartamenti.vercel.app

# Конфигурация на сървъра (по подразбиране: HOST=127.0.0.1, PORT=5000, debug изкл.)
# При деплой на Render/Railway задай:
# HOST=0.0.0.0
# PORT=8000
# FLASK_DEBUG=0