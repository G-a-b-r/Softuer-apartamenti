# ─────────────────────────────────────────────────────────────────────────────
# КОНФИГУРАЦИЯ ЗА BACKEND (Render / Railway / Fly.io)
# Копирай този файл като .env само за ЛОКАЛНО тестване.
# В production задай тези стойности в настройките на платформата (не ги качвай в git).
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL конекция (Neon / Supabase / Render DB).
# В Render се задава автоматично от под. DB. При локална разработка остави празно
# и ще се използва SQLite (backend/apartments.db).
DATABASE_URL=

# Разрешени CORS произходи (запетая разделени). В production задай домейна на Vercel:
CORS_ALLOWED_ORIGINS=https://softuer-apartamenti.vercel.app

# Локален сървър
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0